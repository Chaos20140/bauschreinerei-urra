# Supabase config for the reviews section.
# - URL und Publishable-Key sind für den Client-Side-Einsatz gedacht;
#   die Datensicherheit liegt bei der RLS-Policy in Supabase.
# - Lokal in `.env.local` ablegen (gitignored).
# - Im CI/CD (GitHub Pages) als Repository-Secrets hinterlegen.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
