{
  "name": "urra-fenster-und-tueren",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node tools/optimize-images.mjs && node tools/generate-sitemap.mjs",
    "build": "tsc -b && vite build && node tools/prerender-routes.mjs",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit && eslint src tools",
    "test": "node --test src/lib/*.test.ts supabase/functions/urra-admin/*.test.ts",
    "images": "node tools/optimize-images.mjs",
    "sitemap": "node tools/generate-sitemap.mjs",
    "csp:hash": "node tools/csp-hash.mjs"
  },
  "dependencies": {
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@supabase/supabase-js": "^2.106.2",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^5.4.11"
  }
}
